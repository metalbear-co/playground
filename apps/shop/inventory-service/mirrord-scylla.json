{
  "key": "{{ get_env(name='USER', default='changeme') }}",
  "target": {
    "path": "deploy/inventory-service",
    "namespace": "shop"
  },
  "feature": {
    "network": {
      "incoming": {
        "mode": "steal",
        "http_filter": {
          "header_filter": "baggage:\\s*[^\\n]*\\bmirrord-session={{key}}\\b"
        }
      }
    },
    "db_branches": [
      {
        "type": "generic",
        "id": "{{key}}-scylla",
        "profile": "scylla",
        "creation_timeout_secs": 300,
        "connection": {
          "params": {
            "host": { "env_var_name": "SCYLLA_HOST", "value": "scylla.scylla-demo.svc.cluster.local" },
            "port": { "env_var_name": "SCYLLA_PORT", "value": "9042" }
          }
        }
      }
    ]
  }
}
