{
  "key": "{{ get_env(name='USER', default='changeme') }}",
  "operator": true,
  "target": {
    "path": "deploy/inventory-service",
    "namespace": "shop"
  },
  "feature": {
    "network": {
      "incoming": {
        "mode": "steal",
        "http_filter": {
          "header_filter": "baggage:\\s*[^\\n]*\\bmirrord-session={{key}}\\b"
        }
      },
      "outgoing": true
    },
    "db_branches": [
      {
        "type": "generic",
        "id": "{{key}}-scylla",
        "profile": "scylla",
        "ttl_secs": 900,
        "creation_timeout_secs": 300,
        "image": "docker.io/scylladb/scylla:2026.3.4",
        "port": 9042,
        "connection": {
          "params": {
            "host": { "env_var_name": "SCYLLA_HOST", "value": "scylla.scylla-demo.svc.cluster.local" },
            "port": { "env_var_name": "SCYLLA_PORT", "value": "9042" },
            "keyspace": { "env_var_name": "SCYLLA_KEYSPACE", "value": "catalog" }
          }
        },
        "args": [
          "--smp", "1",
          "--memory", "1G",
          "--reserve-memory", "256M",
          "--overprovisioned", "1",
          "--developer-mode", "1",
          "--reactor-backend", "epoll"
        ],
        "readiness": {
          "type": "exec",
          "command": ["cqlsh", "-e", "SELECT now() FROM system.local"]
        },
        "copy": {
          "image": "docker.io/scylladb/scylla:2026.3.4",
          "command": ["bash", "-c"],
          "args": [
            "set -euo pipefail; src=\"${MIRRORD_PARAM_HOST} ${MIRRORD_PARAM_PORT}\"; dst=\"${MIRRORD_BRANCH_HOST} ${MIRRORD_BRANCH_PORT}\"; ks=\"${MIRRORD_PARAM_KEYSPACE}\"; cqlsh $src -e \"DESCRIBE KEYSPACE ${ks}\" | sed -E \"/CREATE KEYSPACE/s/\\{[^}]*\\}/{'class': 'NetworkTopologyStrategy', 'replication_factor': 1}/\" > /tmp/schema.cql; cqlsh $dst -f /tmp/schema.cql; cqlsh $src -e \"SELECT table_name FROM system_schema.tables WHERE keyspace_name = '${ks}'\" | sed -E \"1,3d; /^\\s*$/d; /rows?\\)/d; s/\\s+//g\" > /tmp/tables; while read -r t; do cqlsh $src -e \"COPY ${ks}.${t} TO '/tmp/${t}.csv'\"; cqlsh $dst -e \"COPY ${ks}.${t} FROM '/tmp/${t}.csv'\"; done < /tmp/tables"
          ]
        }
      }
    ]
  }
}
