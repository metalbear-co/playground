#!/usr/bin/env bash
# mm — one-line mirrord developer experience for the MetalMart shop.
#
# This is a single-file CLI wrapper around `mirrord up`. Instead of asking every
# developer to install mirrord, authenticate to the cloud, fetch cluster credentials,
# and write a mirrord-up.yaml, they run:
#
#   mm run order-service
#
# and the wrapper handles everything else (installing mirrord, cloud auth, kube
# context, config scaffolding, session key, and starting the service).
#
# The wrapper owns its mirrord-up.yaml completely: on first run it scaffolds one
# with an entry per runnable service in the repo — target deployment plus the
# local run command, nothing else. `mirrord up` itself supplies the rest: steal
# mode with a per-developer header filter and queue splitting, both keyed on the
# session key — so a customer starts from scratch with zero mirrord knowledge.
# Per-service mirrord.json files that may exist in the repo are NOT used; those
# serve other workflows. Company-specific config (env overrides, database
# branches) belongs in the scaffold template embedded below, so every developer
# gets it automatically.
#
# ─── WHAT THIS IS ────────────────────────────────────────────────────────────
# An example wrapper, not part of mirrord. MetalBear does not maintain it, and it
# carries no support or compatibility commitment.
#
# Verified against mirrord v3.251.0. Later mirrord releases may change the config
# schema and CLI output this script depends on, and it isn't guaranteed to keep up.
#
# To adapt it:
#   1. CONFIGURATION block below (cluster coordinates, namespace, paths).
#   2. The mirrord-up.yaml template in `scaffold_config` — where mirrord features go.
#   3. `service_command` if your services don't start with `npm run dev`.
#   4. The GKE auth functions for your provider (EKS, AKS, on-prem).
# Sections you are expected to touch are marked with "CUSTOMIZE:".
#
# Usage:
#   mm run <service...> [--key NAME] [--namespace NS] [--migrate] [--ui]
#   mm list                 List runnable services
#   mm config               Print the mirrord-up config (for debugging)
#   mm setup                Install mirrord + authenticate + fetch cluster creds
#   mm sessions             Show active mirrord operator sessions
#   mm cleanup <id|--mine>  Kill one operator session (or every session you own)
#   mm doctor               Check every prerequisite and report OK/FAIL
#   mm extension            Open the mirrord browser-extension install page
#
set -euo pipefail

# ─── CONFIGURATION ───────────────────────────────────────────────────────────
# CUSTOMIZE: everything in this block is specific to your org/cluster.

# GKE cluster coordinates. `gcloud container clusters get-credentials` uses these
# to write the kube context, and the context name below is what GKE generates.
GCP_PROJECT='playground-383912'
GCP_ZONE='us-central1-c'
GKE_CLUSTER='playground-cluster-1'
KUBE_CONTEXT="gke_${GCP_PROJECT}_${GCP_ZONE}_${GKE_CLUSTER}"

# Kubernetes namespace where the workloads are deployed. Each service directory
# name is assumed to match its Deployment name (change `target.path` in the
# scaffolded mirrord-up.yaml where that doesn't hold).
DEFAULT_NAMESPACE='shop'

# Directory that contains one sub-directory per service. The wrapper discovers
# services from this layout, so adding a new service to the repo makes it
# runnable with zero wrapper changes. Resolved relative to this script's real
# location — following symlinks — so `mm` works from any working directory,
# including when it's symlinked onto PATH (ln -s .../scripts/mm ~/.local/bin/mm).
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  link_target="$(readlink "$SCRIPT_PATH")"
  # A relative symlink target is relative to the directory holding the link.
  [[ "$link_target" == /* ]] || link_target="$(dirname "$SCRIPT_PATH")/${link_target}"
  SCRIPT_PATH="$link_target"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
SERVICES_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# The wrapper-owned mirrord-up.yaml. Scaffolded on first use from the template
# in `scaffold_config` below; deliberately separate from any mirrord.json files
# individual services may carry for other workflows. Each service's
# `run.directory` is relative to this file's directory, hence `../<service>`.
MM_CONFIG_DIR="${SERVICES_DIR}/.mirrord"
MM_CONFIG_FILE="${MM_CONFIG_DIR}/mirrord-up.yaml"

# How mirrord gets installed when missing (Homebrew tap; see
# https://metalbear.com/mirrord/docs for other install methods).
MIRRORD_TAP_FORMULA='metalbear-co/mirrord/mirrord'

# mirrord browser extension — lets developers tag their browser traffic with the
# session key so the operator routes only *their* requests to their laptop.
EXTENSION_URL='https://chromewebstore.google.com/detail/mirrord/bijejadnnfgjkfdocgocklekjhnhkhkf'

# Session key. `mirrord up --key` sets it; mirrord derives the HTTP steal filter
# (baggage: .*mirrord-session=<key>.*) and the queue-split filters from it, and
# exposes it to the config file as the `key` template variable. It defaults to
# the OS username — mirrord's own default — and --key overrides it per run.
# CUSTOMIZE: to derive the key differently (e.g. from the git branch), change
# default_key().
default_key() { printf '%s' "${USER:-dev}"; }

# Template variables the wrapper exports for the scaffolded mirrord-up.yaml
# (read there with get_env). Exported for the mirrord process only.
NAMESPACE_ENV_VAR='MM_NAMESPACE'   # target namespace (--namespace)
MIGRATE_ENV_VAR='MM_MIGRATE'       # service running against a database branch (--migrate)

# `--migrate` database-branch defaults. The branch is an isolated copy of the
# service's database that lives only as long as the session (+ ttl_secs), so
# schema changes and migrations never touch the shared database.
# CUSTOMIZE: match these to your databases.
DB_BRANCH_TYPE='pg'                      # pg | mysql | mongodb | mssql | redis
DB_BRANCH_VERSION='16.0'                 # database engine version for the branch
DB_BRANCH_CONNECTION_ENV='DATABASE_URL'  # env var holding the connection string
DB_BRANCH_COPY_MODE='all'                # 'all' = schema + data; 'schema' = structure only
DB_BRANCH_TTL_SECS=30                    # keep the branch briefly after the session ends

# ─── SMALL HELPERS ───────────────────────────────────────────────────────────

die() { echo "mm: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
note() { echo "mm: $*"; }

usage() {
  cat <<'EOF'
mm — run MetalMart shop services locally against the shared GKE cluster via mirrord up

Commands:
  run <service...> Start service(s) locally inside mirrord sessions — multiple
                  services run concurrently in one `mirrord up`, sharing one session key
  list            List services this wrapper can run
  config          Print the mirrord-up config and the template variables in effect
  setup           Install mirrord, authenticate to Google Cloud, fetch cluster creds
  sessions        List active mirrord operator sessions on the cluster
  cleanup <id>    Kill one operator session by ID (or --mine for all of yours)
  doctor          Verify every prerequisite (gcloud, kubectl, mirrord, cluster, config)
  extension       Open the mirrord browser extension install page

Options for `run`:
  --key <name>        Session key used in the traffic filters (default: your username)
  --namespace <ns>    Kubernetes namespace of the targets (default: shop)
  --migrate           Run against an isolated database branch instead of the
                      shared database — safe for schema changes and migrations.
                      The service starts normally with DATABASE_URL pointing at
                      the branch; the branch's local address is printed once
                      it is ready. Single service only.
  --ui                Also start `mirrord ui` in the background
  --config <file>     Use an alternate mirrord-up.yaml instead of the scaffolded one

Queue splitting needs no flag: mirrord up splits every queue registered for a
target (Kafka, SQS, Pub/Sub, ...) by the same session key as the HTTP filter.

The wrapper scaffolds its own mirrord-up.yaml — one entry per runnable service —
into .mirrord/mirrord-up.yaml on first run. Edit that file (target names, env
overrides, config_patch) or the template inside this script to add
company-specific mirrord features; delete it to re-scaffold.

Examples:
  mm setup
  mm list
  mm run order-service
  mm run order-service chat-service
  mm run order-service --key alice
  mm run order-service --namespace staging
  mm run inventory-service --migrate
  mm config
  mm sessions
  mm cleanup 8DD5CC32EFB3F230
  mm doctor
EOF
}

# ─── PREREQUISITES: mirrord ──────────────────────────────────────────────────

ensure_mirrord() {
  have mirrord && return 0
  have brew || die "mirrord not found and Homebrew is unavailable — install mirrord manually: https://metalbear.com/mirrord/docs"
  note "mirrord not found — installing via brew (${MIRRORD_TAP_FORMULA})..."
  brew install "$MIRRORD_TAP_FORMULA"
  have mirrord || die 'mirrord install finished but the binary is still not on PATH'
}

# ─── PREREQUISITES: Google Cloud auth ────────────────────────────────────────
# CUSTOMIZE: this whole section is the GKE flavor. For EKS/AKS/on-prem, replace
# these functions; the rest of the wrapper never touches cloud specifics.

# An ACTIVE gcloud account is required for kubectl to mint GKE tokens.
# If none is present, run the interactive browser login.
ensure_gcloud_auth() {
  have gcloud || die 'gcloud CLI not found — install: https://cloud.google.com/sdk/docs/install'
  local account
  account="$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null | head -1)"
  if [[ -z "$account" ]]; then
    note 'no active Google Cloud account — running gcloud auth login (browser will open)...'
    gcloud auth login --quiet || die 'gcloud auth login failed'
    account="$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null | head -1)"
    [[ -n "$account" ]] || die 'still no active gcloud account after login'
  fi
  note "Google Cloud account: $account"
}

# kubectl talks to GKE through the gke-gcloud-auth-plugin binary. The kubeconfig
# written by `get-credentials` references it by absolute path inside the gcloud
# SDK, so check both PATH and the SDK's bin directory before declaring it missing.
gke_plugin_available() {
  have gke-gcloud-auth-plugin && return 0
  local sdk_root
  sdk_root="$(gcloud info --format='value(installation.sdk_root)' 2>/dev/null || true)"
  [[ -n "$sdk_root" && -x "${sdk_root}/bin/gke-gcloud-auth-plugin" ]]
}

# The plugin ships as a gcloud component, so install it in place when missing.
ensure_gke_auth_plugin() {
  gke_plugin_available && return 0
  note 'gke-gcloud-auth-plugin missing — installing via gcloud components...'
  gcloud components install gke-gcloud-auth-plugin --quiet \
    || die 'failed to install gke-gcloud-auth-plugin (run manually: gcloud components install gke-gcloud-auth-plugin)'
  gke_plugin_available || die 'gke-gcloud-auth-plugin installed but not found — restart your shell'
}

# Make sure the kubeconfig has our cluster's context. `get-credentials` is
# idempotent, so it's safe to re-run when the context already exists.
ensure_kube_context() {
  have kubectl || die 'kubectl not found — install it (gcloud components install kubectl, or brew install kubectl)'
  if ! kubectl config get-contexts -o name 2>/dev/null | grep -qx "$KUBE_CONTEXT"; then
    note "kube context '$KUBE_CONTEXT' missing — fetching cluster credentials..."
    gcloud container clusters get-credentials "$GKE_CLUSTER" \
      --zone "$GCP_ZONE" --project "$GCP_PROJECT" \
      || die "gcloud container clusters get-credentials failed for ${GKE_CLUSTER}"
  fi
}

# Cheap end-to-end check that auth + network + RBAC all work: can we see the
# target namespace? Failing here gives a clear message before mirrord starts.
verify_cluster_access() {
  local namespace="$1"
  if ! kubectl --context "$KUBE_CONTEXT" get ns "$namespace" >/dev/null 2>&1; then
    note 'cluster unreachable — credentials may have expired; retrying after re-auth...'
    gcloud auth login --quiet || die 'gcloud auth login failed'
    kubectl --context "$KUBE_CONTEXT" get ns "$namespace" >/dev/null 2>&1 \
      || die "cannot reach namespace '$namespace' on context '$KUBE_CONTEXT' (check VPN/permissions, or run: mm doctor)"
  fi
}

# One call that takes a fresh laptop to "ready to run mirrord".
ensure_cluster_ready() {
  local namespace="$1"
  ensure_gcloud_auth
  ensure_gke_auth_plugin
  ensure_kube_context
  verify_cluster_access "$namespace"
}

# ─── SERVICE DISCOVERY ───────────────────────────────────────────────────────

# A directory under SERVICES_DIR counts as a runnable service when it contains
# something we know how to start (see service_command). This keeps the wrapper
# zero-maintenance: new services show up in `mm list` automatically.
# CUSTOMIZE: extend the markers if you add stacks (go.mod, build.gradle, ...).
is_service_dir() {
  local d="$1"
  [[ -f "${d}/package.json" || -f "${d}/main.py" ]]
}

list_services() {
  local d
  for d in "$SERVICES_DIR"/*/; do
    if is_service_dir "$d"; then
      basename "$d"
    fi
  done
  # Explicit success: with `set -e`, a trailing failed test here would
  # otherwise abort the whole script when the last directory is not a service.
  return 0
}

service_dir() {
  local service="$1"
  local dir="${SERVICES_DIR}/${service}"
  if [[ ! -d "$dir" ]] || ! is_service_dir "$dir"; then
    die "unknown service '$service' — available: $(list_services | tr '\n' ' ')"
  fi
  printf '%s' "$dir"
}

# Decide how to start a service locally, based on what's in its directory. The
# command runs with the service directory as working directory (mirrord up sets
# it from `run.directory`), so paths are relative to the service. The result is
# returned via the RUN_ARGV array (bash can't return arrays). Pure: no installs
# here, because this also runs while scaffolding the config for every service.
# CUSTOMIZE: add cases here for other stacks (go run ., ./gradlew bootRun, ...).
service_command() {
  local dir="$1"
  RUN_ARGV=()
  if [[ -f "${dir}/package.json" ]]; then
    # Node/TypeScript services (and the Next.js frontend) all expose `npm run dev`.
    RUN_ARGV=(npm run dev)
  elif [[ -f "${dir}/main.py" ]]; then
    RUN_ARGV=(.venv/bin/python main.py)
  else
    die "don't know how to run this service — add a case to service_command()"
  fi
}

# First-run dependency setup for a service about to be started, so `mm run`
# works on a fresh clone. Mirrors the stacks in service_command.
service_prepare() {
  local dir="$1"
  if [[ -f "${dir}/package.json" ]]; then
    if [[ ! -d "${dir}/node_modules" ]]; then
      note "node_modules missing in $(basename "$dir") — running npm install first..."
      (cd "$dir" && npm install)
    fi
  elif [[ -f "${dir}/main.py" ]]; then
    if [[ ! -d "${dir}/.venv" ]]; then
      note "creating Python virtualenv for $(basename "$dir") and installing requirements..."
      (cd "$dir" && python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt)
    fi
  fi
}

# ─── MIRRORD-UP CONFIG (wrapper-owned) ───────────────────────────────────────

# Render argv as a YAML flow sequence of double-quoted strings.
yaml_command() {
  local out='' arg
  for arg in "$@"; do
    arg="${arg//\\/\\\\}"
    arg="${arg//\"/\\\"}"
    out="${out:+${out}, }\"${arg}\""
  done
  printf '[%s]' "$out"
}

# Write the wrapper's mirrord-up.yaml on first use: one `services` entry per
# runnable service, each with its target deployment and local run command.
# Written only when the file doesn't exist, so local edits survive; delete the
# file to re-scaffold (e.g. after adding a service to the repo).
#
# What is NOT in the file is what makes sharing a cluster safe, because
# `mirrord up` adds it for every service: STEAL incoming traffic, but only
# requests whose `baggage` header carries this developer's session key, and
# split every queue registered for the target by the same key — everyone
# else's traffic keeps flowing to the deployed pod.
#
# The file is rendered as a Tera template before parsing, which is how the
# per-run switches work without editing the file: `mm run` exports
# $NAMESPACE_ENV_VAR / $MIGRATE_ENV_VAR and the template reads them with
# get_env(). The `key` template variable is the session key.
#
# CUSTOMIZE: this template is the place for company-specific mirrord features,
# e.g. per service:
#   env:
#     override: {SOME_FLAG: local}
#   http_filter: {header_filter: "..."}   (tighter than mirrord's default)
#   config_patch: {...}                    (any mirrord.json option, e.g. db_branches)
# Docs: https://metalbear.com/mirrord/docs/use-cases/multiple-concurrent-sessions
scaffold_config() {
  [[ -f "$MM_CONFIG_FILE" ]] && return 0
  mkdir -p "$MM_CONFIG_DIR"
  local svc
  {
    # Comments in the file avoid template braces on purpose: Tera renders the
    # whole file, comments included.
    cat <<EOF
# mirrord-up.yaml owned by the \`mm\` wrapper — one entry per runnable service.
# Edit freely (target names, env overrides, config_patch); delete to re-scaffold.
# Reference: https://metalbear.com/mirrord/docs/use-cases/multiple-concurrent-sessions
#
# \`mm run <service...>\` launches only the named entries. For each of them
# mirrord up steals the incoming requests whose baggage header carries the
# session key (baggage: .*mirrord-session=<key>.*) and splits every queue
# registered for the target by the same key; everything else keeps flowing
# to the deployed pod.
#
# Template variables (rendered before the file is parsed):
#   key            the session key (mm run --key, default: your username)
#   ${NAMESPACE_ENV_VAR}   target namespace (mm run --namespace, default: ${DEFAULT_NAMESPACE})
#   ${MIGRATE_ENV_VAR}     the service running against a database branch (mm run --migrate)

# --migrate: run the named service against an isolated copy of its database.
# config_patch is mirrord up's escape hatch for mirrord.json options such as
# db_branches. The macro is expanded once per service below.
{% macro db_branch(service) %}
{% if get_env(name='${MIGRATE_ENV_VAR}', default='') == service %}
    config_patch:
      feature:
        db_branches:
          - id: "{{ key }}01-branch-db"
            type: ${DB_BRANCH_TYPE}
            version: "${DB_BRANCH_VERSION}"
            ttl_secs: ${DB_BRANCH_TTL_SECS}
            connection: {url: ${DB_BRANCH_CONNECTION_ENV}}
            copy: {mode: ${DB_BRANCH_COPY_MODE}}
{% endif %}
{% endmacro %}

common:
  operator: true
  context: ${KUBE_CONTEXT}

services:
EOF
    for svc in $(list_services); do
      service_command "${SERVICES_DIR}/${svc}"
      printf '  %s:\n' "$svc"
      printf '    target:\n'
      printf '      path: deployment/%s\n' "$svc"
      printf "      namespace: \"{{ get_env(name='%s', default='%s') }}\"\n" "$NAMESPACE_ENV_VAR" "$DEFAULT_NAMESPACE"
      printf '    run:\n'
      printf '      directory: ../%s\n' "$svc"
      printf '      command: %s\n' "$(yaml_command "${RUN_ARGV[@]}")"
      printf "    {{ self::db_branch(service='%s') }}\n\n" "$svc"
    done
  } >"$MM_CONFIG_FILE"
  note "scaffolded mirrord-up config → ${MM_CONFIG_FILE} ($(list_services | wc -l | tr -d ' ') services; edit to add company-specific features)"
}

# Report the database branch created for this session (`--migrate`). The
# connection data comes from `mirrord db-branches connections --format json`,
# which only lists a branch once the session's portforward is up — so this
# runs in the background, polling while mirrord starts (copying the shared
# database can take a while), and prints one line per branch when ready.
# Entries are matched on the session key, so only this session's branch is
# reported even when other sessions have branches open on this machine.
# Needs a mirrord with JSON output on `db-branches connections` (newer than
# 3.251.0); on older versions this silently reports nothing.
report_db_branch() {
  local session_key="$1" deadline=$((SECONDS + 300)) json rows
  mirrord db-branches connections --help 2>/dev/null | grep -q -- '--format' || return 0
  while (( SECONDS < deadline )); do
    json="$(mirrord db-branches connections --format json 2>/dev/null)" || json=''
    rows=''
    if [[ -n "$json" && "$json" != '[]' ]]; then
      if have jq; then
        rows="$(jq -r --arg k "$session_key" \
          '.[] | select(.key == $k) | "\(.db_id) at \(.connection_string)"' \
          <<<"$json" 2>/dev/null)" || rows=''
      elif have python3; then
        rows="$(python3 -c '
import json, sys
for c in json.loads(sys.argv[1]):
    if c.get("key") == sys.argv[2]:
        print(c["db_id"] + " at " + c["connection_string"])
' "$json" "$session_key" 2>/dev/null)" || rows=''
      fi
    fi
    if [[ -n "$rows" ]]; then
      local line
      while IFS= read -r line; do
        note "database branch ready: ${line}"
      done <<<"$rows"
      note "→ ${DB_BRANCH_CONNECTION_ENV} inside the service points at the branch"
      return 0
    fi
    sleep 2
  done
  return 0
}

# Print the part of the mirrord-up config a run will use: the `common` block
# and the entries of the selected services, straight from the file (templates
# unrendered — the variables they read are printed alongside), so a developer
# sees exactly what `mirrord up` is about to launch and where to edit it.
print_run_config() {
  local config="$1"; shift
  local services="$*"
  note "mirrord-up config (${config}):"
  awk -v wanted=" ${services} " '
    /^common:/   { section = "common";   keep = 1 }
    /^services:/ { section = "services"; keep = 1 }
    /^[^ #]/ && !/^(common|services):/ { section = ""; keep = 0 }
    section == "services" && /^  [^ #][^:]*:/ {
      name = $1; sub(/:$/, "", name); keep = index(wanted, " " name " ") > 0
    }
    keep && !/^[[:space:]]*$/ { print }
  ' "$config"
}

# Minimal mirrord config for operator commands (`mirrord operator status` /
# `session kill`), which need the kube context and operator flag only.
write_operator_config() {
  local out="$1"
  printf 'kube_context: "%s"\noperator: true\n' "$KUBE_CONTEXT" >"$out"
}

# ─── COMMANDS ────────────────────────────────────────────────────────────────

cmd_list() {
  echo 'Runnable services:'
  list_services | sed 's/^/  /'
}

# `mm config` — show the mirrord-up config `mm run` would launch with, and the
# template variables it would export. The file is printed as-is (templates
# unrendered): `mirrord up` renders it at launch, and the variables listed at
# the top are everything the templates can read.
cmd_config() {
  local key='' config_file="$MM_CONFIG_FILE" namespace="$DEFAULT_NAMESPACE" migrate=''
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --key)       [[ $# -ge 2 ]] || die '--key requires a value';       key="$2"; shift 2 ;;
      --config)    [[ $# -ge 2 ]] || die '--config requires a value';    config_file="$2"; shift 2 ;;
      --namespace) [[ $# -ge 2 ]] || die '--namespace requires a value'; namespace="$2"; shift 2 ;;
      --migrate)   [[ $# -ge 2 ]] || die '--migrate requires the service name here (mm config --migrate <service>)'; migrate="$2"; shift 2 ;;
      -h|--help)
        echo 'usage: mm config [--key NAME] [--namespace NS] [--migrate SERVICE] [--config FILE]'
        echo 'Prints the mirrord-up config and the template variables in effect for such a run.'
        return 0 ;;
      *) die "unknown config option: $1" ;;
    esac
  done

  scaffold_config
  [[ -f "$config_file" ]] || die "config file not found: $config_file"
  key="${key:-$(default_key)}"
  note "mirrord-up config: ${config_file}"
  note "template variables: key=${key} ${NAMESPACE_ENV_VAR}=${namespace} ${MIGRATE_ENV_VAR}=${migrate:-<unset>}"
  note "→ mirrord up adds per service: steal filtered by 'baggage: .*mirrord-session=${key}.*', queue splitting by the same key"
  cat "$config_file"
}

cmd_setup() {
  ensure_mirrord
  scaffold_config
  ensure_cluster_ready "$DEFAULT_NAMESPACE"
  note "setup complete — mirrord=$(command -v mirrord), context=${KUBE_CONTEXT}, config=${MM_CONFIG_FILE}"
  note "try: mm run $(list_services | head -1)"
}

cmd_run() {
  local namespace="$DEFAULT_NAMESPACE" key='' config_file="$MM_CONFIG_FILE"
  local migrate=0 ui=0
  local -a services=() up_flags=() RUN_ARGV=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --key)       [[ $# -ge 2 ]] || die '--key requires a value';       key="$2"; shift 2 ;;
      --namespace) [[ $# -ge 2 ]] || die '--namespace requires a value'; namespace="$2"; shift 2 ;;
      --config)    [[ $# -ge 2 ]] || die '--config requires a value';    config_file="$2"; shift 2 ;;
      --migrate)   migrate=1; shift ;;
      --ui)        ui=1; shift ;;
      -h|--help)   usage; return 0 ;;
      # Things that moved into the config file with mirrord up — say where.
      --target)    die "--target is gone: set services.<service>.target.path in ${MM_CONFIG_FILE}" ;;
      --split-queues) die 'queue splitting needs no flag — mirrord up splits every registered queue by the session key' ;;
      --)          die "extra service arguments are gone: edit services.<service>.run.command in ${MM_CONFIG_FILE}" ;;
      -*)          die "unknown run option: $1" ;;
      *)           services+=("$1"); shift ;;
    esac
  done

  [[ ${#services[@]} -gt 0 ]] || die "service is required — try: mm run $(list_services | head -1)  (see: mm list)"
  # One branch id per key: concurrent sessions would collide on it.
  if (( migrate )) && [[ ${#services[@]} -gt 1 ]]; then
    die '--migrate only works with a single service'
  fi

  # Validate every service before starting anything, so a typo in the second
  # name doesn't leave the first one already running.
  local svc
  for svc in "${services[@]}"; do
    service_dir "$svc" >/dev/null
  done

  ensure_mirrord
  scaffold_config
  [[ -f "$config_file" ]] || die "config file not found: $config_file"

  for svc in "${services[@]}"; do
    service_prepare "$(service_dir "$svc")"
  done

  ensure_cluster_ready "$namespace"

  # Session key: passed to mirrord up, which derives the traffic filters from
  # it and exposes it to the config file as the `key` template variable.
  key="${key:-$(default_key)}"

  # Per-run switches for the templates in the config file. Exporting them here
  # only affects the mirrord child process, not your shell.
  export "${NAMESPACE_ENV_VAR}=${namespace}"
  if (( migrate )); then
    export "${MIGRATE_ENV_VAR}=${services[0]}"
    note "database branch enabled — ${DB_BRANCH_CONNECTION_ENV} will point at an isolated ${DB_BRANCH_TYPE} branch (copy=${DB_BRANCH_COPY_MODE}); the shared database stays untouched"
  fi
  (( ui )) && up_flags+=(--ui)

  note "session key: ${key}"
  note "→ only requests carrying 'baggage: ... mirrord-session=${key}' (and queue messages tagged the same way) are routed to your laptop"
  note "→ install the browser extension to tag your traffic: mm extension"
  note "services=${services[*]} namespace=${namespace} context=${KUBE_CONTEXT}"
  note "template variables: key=${key} ${NAMESPACE_ENV_VAR}=${namespace} ${MIGRATE_ENV_VAR}=${!MIGRATE_ENV_VAR:-<unset>}"
  print_run_config "$config_file" "${services[@]}"

  # --migrate: the exec below replaces this shell, so the branch watcher must
  # be launched first. It shares the terminal and prints its report amid the
  # service logs once the branch is ready; on Ctrl-C it dies with the session
  # (same process group), and its polling is time-bounded either way.
  if (( migrate )); then
    report_db_branch "$key" &
  fi

  # exec replaces this script with mirrord up, so Ctrl-C reaches it directly
  # and no orphan wrapper process is left behind. mirrord up runs one session
  # per named service, all sharing the key — so one baggage header routes an
  # entire request chain to this laptop — and tears them all down together.
  # --context is passed explicitly so an alternate --config file still lands
  # on this cluster (the flag wins over `common.context` in the file).
  exec mirrord up \
    --config-file "$config_file" \
    --key "$key" \
    --context "$KUBE_CONTEXT" \
    ${up_flags[@]+"${up_flags[@]}"} \
    "${services[@]}"
}

cmd_sessions() {
  ensure_mirrord
  ensure_cluster_ready "$DEFAULT_NAMESPACE"
  # Operator status includes the table of active sessions (who, target, since).
  local op_cfg="${TMPDIR:-/tmp}/mm-operator-$$.yaml"
  write_operator_config "$op_cfg"
  mirrord operator status -f "$op_cfg"
  rm -f "$op_cfg"
}

cmd_cleanup() {
  local session_id='' kill_mine=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mine) kill_mine=1; shift ;;
      --all) die 'the cluster is shared — mm only kills your own sessions (use --mine)' ;;
      -h|--help)
        echo 'usage: mm cleanup <session-id> | mm cleanup --mine'
        echo 'Session IDs come from: mm sessions'
        return 0 ;;
      -*) die "unknown cleanup option: $1" ;;
      *)
        [[ -z "$session_id" ]] || die 'cleanup accepts at most one session ID'
        session_id="$1"; shift ;;
    esac
  done

  ensure_mirrord
  ensure_cluster_ready "$DEFAULT_NAMESPACE"
  local op_cfg="${TMPDIR:-/tmp}/mm-operator-$$.yaml"
  write_operator_config "$op_cfg"

  if (( kill_mine )); then
    # Deliberately no kill-all: the cluster is shared, and tearing down other
    # developers' sessions from a convenience wrapper is too easy to do by
    # accident. "Mine" means sessions opened from this OS username — the
    # operator attributes every session to <os-user>/<k8s-user>@<hostname>
    # in the User column of `mirrord operator status`.
    local me my_rows ids
    me="${USER:-$(id -un)}"
    my_rows="$(mirrord operator status -f "$op_cfg" | awk -F'|' -v me="$me" '
      NF >= 7 {
        id = $2; gsub(/ /, "", id)
        user = $5; gsub(/^ +| +$/, "", user)
        if (id ~ /^[0-9a-fA-F]+$/ && index(user, me "/") == 1) print
      }' | sort -u)"
    if [[ -z "$my_rows" ]]; then
      rm -f "$op_cfg"
      note "no active sessions belong to ${me}"
      return 0
    fi
    echo "mm: active sessions belonging to ${me}:"
    echo "$my_rows"
    read -r -p 'mm: kill all of YOUR sessions listed above? [y/N] ' answer
    [[ "$answer" =~ ^[Yy]$ ]] || { rm -f "$op_cfg"; die 'aborted'; }
    ids="$(awk -F'|' '{ id = $2; gsub(/ /, "", id); print id }' <<<"$my_rows" | sort -u)"
    local id
    for id in $ids; do
      mirrord operator session kill --id "$id" -f "$op_cfg"
    done
  else
    [[ -n "$session_id" ]] || { rm -f "$op_cfg"; die 'session ID required (see: mm sessions), or pass --mine'; }
    [[ "$session_id" =~ ^[[:xdigit:]]+$ ]] || { rm -f "$op_cfg"; die "invalid session ID: $session_id"; }
    mirrord operator session kill --id "$session_id" -f "$op_cfg"
  fi
  rm -f "$op_cfg"
}

cmd_extension() {
  if have open; then open "$EXTENSION_URL"
  elif have xdg-open; then xdg-open "$EXTENSION_URL"
  else echo "$EXTENSION_URL"
  fi
}

# Non-mutating health report: checks every prerequisite `mm run` relies on and
# prints OK/FAIL per item, so support requests start with `mm doctor` output.
cmd_doctor() {
  local ok=1

  check() {
    local label="$1" status="$2" detail="${3:-}"
    if [[ "$status" == ok ]]; then
      printf '  OK   %s%s\n' "$label" "${detail:+ ($detail)}"
    else
      printf '  FAIL %s%s\n' "$label" "${detail:+ — $detail}"
      ok=0
    fi
  }

  echo "mm doctor (project=${GCP_PROJECT} cluster=${GKE_CLUSTER} context=${KUBE_CONTEXT} namespace=${DEFAULT_NAMESPACE})"

  if have gcloud; then check gcloud ok "$(gcloud --version 2>/dev/null | head -1)"; else check gcloud fail 'install: https://cloud.google.com/sdk/docs/install'; fi
  if gke_plugin_available; then check gke-gcloud-auth-plugin ok; else check gke-gcloud-auth-plugin fail 'run: gcloud components install gke-gcloud-auth-plugin'; fi
  if have kubectl; then check kubectl ok; else check kubectl fail 'not on PATH'; fi
  if have mirrord; then
    check mirrord ok "$(mirrord --version 2>/dev/null | head -1)"
    if mirrord up --help >/dev/null 2>&1; then
      check 'mirrord up' ok
    else
      check 'mirrord up' fail 'this mirrord has no `up` command — upgrade: brew upgrade mirrord'
    fi
  else
    check mirrord fail 'run: mm setup'
  fi
  if have npm; then check npm ok; else check npm fail 'needed for the Node services'; fi

  if have gcloud; then
    local account
    account="$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null | head -1)"
    if [[ -n "$account" ]]; then
      check 'gcloud auth' ok "$account"
    else
      check 'gcloud auth' fail 'run: gcloud auth login'
    fi
  fi

  if have kubectl; then
    if kubectl config get-contexts -o name 2>/dev/null | grep -qx "$KUBE_CONTEXT"; then
      check "kube context" ok "$KUBE_CONTEXT"
    else
      check "kube context" fail "run: gcloud container clusters get-credentials ${GKE_CLUSTER} --zone ${GCP_ZONE} --project ${GCP_PROJECT}"
    fi
    if kubectl --context "$KUBE_CONTEXT" get ns "$DEFAULT_NAMESPACE" >/dev/null 2>&1; then
      check "cluster access (${DEFAULT_NAMESPACE})" ok
    else
      check "cluster access (${DEFAULT_NAMESPACE})" fail 'kubectl cannot reach the namespace (auth expired? permissions?)'
    fi
  fi

  if have mirrord && have kubectl; then
    local op_cfg="${TMPDIR:-/tmp}/mm-doctor-$$.yaml"
    write_operator_config "$op_cfg"
    if mirrord operator status -f "$op_cfg" >/dev/null 2>&1; then
      check 'mirrord operator' ok
    else
      check 'mirrord operator' fail 'operator not reachable on this cluster'
    fi
    rm -f "$op_cfg"
  fi

  if [[ -f "$MM_CONFIG_FILE" ]]; then
    # A service added to the repo after scaffolding is missing from the file;
    # `mirrord up` would reject it by name. Re-scaffolding picks it up.
    local svc missing=''
    for svc in $(list_services); do
      grep -Eq "^  ${svc}:" "$MM_CONFIG_FILE" || missing="${missing:+${missing} }${svc}"
    done
    if [[ -z "$missing" ]]; then
      check 'mm config' ok "$MM_CONFIG_FILE"
    else
      check 'mm config' fail "${MM_CONFIG_FILE} lacks: ${missing} — add them, or delete the file to re-scaffold"
    fi
  else
    check 'mm config' ok 'not scaffolded yet (created automatically on first run)'
  fi

  local n
  n="$(list_services | wc -l | tr -d ' ')"
  if [[ "$n" -gt 0 ]]; then
    check 'services' ok "$n runnable under ${SERVICES_DIR}"
  else
    check 'services' fail "no runnable services found under ${SERVICES_DIR}"
  fi

  if [[ "$ok" -eq 1 ]]; then
    echo 'mm doctor: all checks passed'
    return 0
  fi
  echo 'mm doctor: some checks failed' >&2
  return 1
}

# ─── ENTRY POINT ─────────────────────────────────────────────────────────────

main() {
  local cmd="${1:-}"
  if [[ -z "$cmd" || "$cmd" == '-h' || "$cmd" == '--help' ]]; then
    usage
    exit 0
  fi
  shift
  case "$cmd" in
    run)       cmd_run "$@" ;;
    config)    cmd_config "$@" ;;
    list)      cmd_list "$@" ;;
    setup)     cmd_setup "$@" ;;
    sessions)  cmd_sessions "$@" ;;
    cleanup)   cmd_cleanup "$@" ;;
    doctor)    cmd_doctor "$@" ;;
    extension) cmd_extension "$@" ;;
    *)
      # `run` is deliberately the only way to start a service — one canonical
      # form, no shortcut. Redirect anyone who types a bare service name.
      if [[ -d "${SERVICES_DIR}/${cmd}" ]] && is_service_dir "${SERVICES_DIR}/${cmd}"; then
        die "services are started with run: mm run ${cmd}${*:+ $*}"
      else
        die "unknown command '$cmd' (try: mm --help, or mm list)"
      fi
      ;;
  esac
}

main "$@"
