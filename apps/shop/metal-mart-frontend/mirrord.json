{
  "key": "{{ get_env(name='USER', default='changeme') }}",
  "target": {
    "namespace": "shop",
    "path": {
      "deployment": "metal-mart-frontend"
    }
  },
  "feature": {
    "env": {
      "exclude": "NODE_ENV",
      "override": {
        "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME": "dxas4fpir"
      }
    },
    "network": {
      "dns": true,
      "incoming": {
        "mode": "steal",
        "http_filter": {
          "header_filter": "baggage:\\s*[^\\n]*\\bmirrord-session={{key}}\\b"
        }
      },
      "outgoing": {
        "ignore_localhost": true
      }
    }
  }
}
