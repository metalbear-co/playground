{
  "key": "{{ get_env(name='USER', default='changeme') }}",
  "target": {
    "namespace": "shop",
    "path": {
      "deployment": "chat-service"
    }
  },
  "feature": {
    "env": {
      "override": {
        "PORT": "8081"
      }
    },
    "network": {
      "incoming": {
        "mode": "steal",
        "port_mapping": [[80, 8081]]
      },
      "outgoing": true
    },
    "split_queues": {
      "support-chat": {
        "queue_type": "Kafka",
        "message_filter": {
          "baggage": ".*mirrord-session={{key}}.*"
        }
      }
    }
  }
}
